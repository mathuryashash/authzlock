From f8d752ccf0e6f409a54e62484ae1b2e80f607600 Mon Sep 17 00:00:00 2001
From: authzlock <authzlock@example.com>
Date: Tue, 20 Oct 2026 16:03:47 +0530
Subject: [PATCH] pr-mut-benign-delete-helper: Benign refactor:
 delete_todo/delete_category share one owner-checked lookup helper

---
 todos/app/dal/db_service.py | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/todos/app/dal/db_service.py b/todos/app/dal/db_service.py
index dd8b852..a9429ce 100644
--- a/todos/app/dal/db_service.py
+++ b/todos/app/dal/db_service.py
@@ -38,6 +38,14 @@ class DBService:
         are_categories_valid: bool = len(todo_categories_ids) == len(categories_from_db)
         return are_categories_valid
 
+    async def _owned(self, session, model, id_, created_by_id, name):  # type: ignore[no-untyped-def]
+        row = await self._repo.get(session, table_model=model, query_filter=model.id == id_)
+        if not row:
+            raise ResourceNotExists(resource=name)
+        if row.created_by_id != created_by_id:
+            raise UserNotAllowed(f'a user can not delete a {name} that was not created by him')
+        return row
+
     async def get_priorities(self, session: AsyncSession) -> list[Priority]:
         return await self._repo.get_multi(session, table_model=Priority)
 
@@ -165,15 +173,7 @@ class DBService:
         id_to_delete: int,
         created_by_id: uuid.UUID
     ) -> None:
-        todo_to_delete: Optional[Todo] = await self._repo.get(
-            session,
-            table_model=Todo,
-            query_filter=Todo.id == id_to_delete
-        )
-        if not todo_to_delete:
-            raise ResourceNotExists(resource='todo')
-        if todo_to_delete.created_by_id != created_by_id:
-            raise UserNotAllowed('a user can not delete a todo that was not created by him')
+        await self._owned(session, Todo, id_to_delete, created_by_id, 'todo')
         await self._repo.delete(session, table_model=Todo, id_to_delete=id_to_delete)
 
 
-- 
