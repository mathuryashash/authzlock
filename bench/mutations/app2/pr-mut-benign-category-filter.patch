From 6cdfe981231908a16ab7c94a30c918c2cda3d231 Mon Sep 17 00:00:00 2001
From: authzlock <authzlock@example.com>
Date: Tue, 20 Oct 2026 20:19:27 +0530
Subject: [PATCH] pr-mut-benign-category-filter: Benign: GET /todos gains an
 optional ?category_id= filter over the caller's own todos

---
 todos/app/api/v1/todos.py | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/todos/app/api/v1/todos.py b/todos/app/api/v1/todos.py
index 54e61f4..2af03a7 100644
--- a/todos/app/api/v1/todos.py
+++ b/todos/app/api/v1/todos.py
@@ -1,3 +1,5 @@
+from typing import Optional
+
 from fastapi import APIRouter, Depends, status
 from sqlalchemy.ext.asyncio import AsyncSession
 from pydantic import conint
@@ -29,14 +31,16 @@ async def get_todos(
     skip: conint(ge=0, le=MAX_POSTGRES_INTEGER) = GET_MULTI_DEFAULT_SKIP,  # type: ignore[valid-type]
     limit: conint(ge=0, le=MAX_POSTGRES_INTEGER) = GET_MULTI_DEFAULT_LIMIT,  # type: ignore[valid-type]
     session: AsyncSession = Depends(get_async_session),
-    user: User = Depends(current_logged_user)
+    user: User = Depends(current_logged_user),
+    category_id: Optional[int] = None
 ) -> Todo:
-    return await db_service.get_todos(
+    todos = await db_service.get_todos(
         session,
         created_by_id=user.id,
         skip=skip,
         limit=limit
     )
+    return [t for t in todos if category_id is None or any(c.id == category_id for c in t.categories)]
 
 
 @router.post(
