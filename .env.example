# Copy to .env (gitignored) and fill in. Only the agent steps need keys;
# `python replay.py site` needs none of these.

# Nebius Token Factory API key (agent steps: onboarding, regression tests, root cause)
NEBIUS_API_KEY=
# Nebius project id (Nebius Sandboxes runner: --runner sandbox)
NEBIUS_PROJECT_ID=
# Tavily Search API key (OWASP/CWE citations on FAIL findings; optional)
TAVILY_API_KEY=
# Postgres used by the probe (matches the docker command in the README Quickstart)
AUTHZ_PG=postgresql://postgres@127.0.0.1:5433/postgres
