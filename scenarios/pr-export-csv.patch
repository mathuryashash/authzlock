diff --git a/backend/app/api/routes/items.py b/backend/app/api/routes/items.py
index f0eb30e..06589eb 100644
--- a/backend/app/api/routes/items.py
+++ b/backend/app/api/routes/items.py
@@ -2,6 +2,7 @@ import uuid
 from typing import Any
 
 from fastapi import APIRouter, HTTPException
+from fastapi.responses import PlainTextResponse
 from sqlmodel import col, func, select
 
 from app.api.deps import CurrentUser, SessionDep
@@ -45,6 +46,17 @@ def read_items(
     return ItemsPublic(data=items_public, count=count)
 
 
+@router.get("/export", response_class=PlainTextResponse)
+def export_items(session: SessionDep, current_user: CurrentUser) -> str:
+    """
+    Export items as CSV.
+    """
+    rows = session.exec(select(Item).order_by(col(Item.created_at).desc())).all()
+    lines = ["id,title,description"]
+    lines += [f"{i.id},{i.title},{i.description or ''}" for i in rows]
+    return "\n".join(lines)
+
+
