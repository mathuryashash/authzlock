{
  "api_prefix": "/api/v1",
  "identities": {
    "anonymous": {"kind": "anonymous"},
    "user_a": {"kind": "login", "owns_items": 7},
    "user_b": {"kind": "login", "owns_items": 3},
    "superuser": {"kind": "login", "owns_items": 2, "superuser": true},
    "inactive": {"kind": "minted", "owns_items": 2, "is_active": false},
    "forged_sig": {"kind": "forged", "as": "user_a"},
    "expired": {"kind": "expired", "as": "user_a"},
    "alg_none": {"kind": "alg_none", "as": "superuser"},
    "deleted_user": {"kind": "deleted"}
  },
  "privileged_identities": ["superuser"],
  "invalid_identities": ["anonymous", "inactive", "forged_sig", "expired", "alg_none", "deleted_user"],
  "targets": ["user_a", "user_b", "superuser", "nonexistent"],
  "ownership": {
    "user": {"owner": "self"},
    "item": {"owner_column": "owner_id"}
  },
  "privilege_columns": {
    "user": ["is_superuser", "is_active"]
  },
  "ignored_columns": {
    "user": ["created_at"],
    "item": ["created_at"]
  },
  "param_hints": {
    "email": "user_email",
    "user_id": "user_id",
    "id": "item_id"
  },
  "public_operations": [
    "POST /login/access-token",
    "POST /password-recovery/{email}",
    "POST /reset-password/",
    "POST /users/signup",
    "GET /utils/health-check/",
    "POST /password-recovery-html-content/{email}"
  ],
  "exceptions": [
    {
      "op": "POST /users/signup",
      "identity": "*",
      "allow": "insert_user_nonprivileged",
      "reason": "Public self-registration endpoint"
    }
  ]
}