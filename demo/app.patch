From 45d24e4eb683df37db7b3fc718a660fb123a5f5a Mon Sep 17 00:00:00 2001
From: demo <demo@example.com>
Date: Fri, 25 Sep 2026 11:02:23 +0000
Subject: [PATCH] refactor(items): dedupe item lookup into a helper

---
 backend/app/api/routes/items.py | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/backend/app/api/routes/items.py b/backend/app/api/routes/items.py
index f0eb30e..e30bcf5 100644
--- a/backend/app/api/routes/items.py
+++ b/backend/app/api/routes/items.py
@@ -45,17 +45,19 @@ def read_items(
     return ItemsPublic(data=items_public, count=count)
 
 
+def _get_item_or_404(session: SessionDep, id: uuid.UUID) -> Item:
+    item = session.get(Item, id)
+    if not item:
+        raise HTTPException(status_code=404, detail="Item not found")
+    return item
+
+
 @router.get("/{id}", response_model=ItemPublic)
 def read_item(session: SessionDep, current_user: CurrentUser, id: uuid.UUID) -> Any:
     """
     Get item by ID.
     """
-    item = session.get(Item, id)
-    if not item:
-        raise HTTPException(status_code=404, detail="Item not found")
-    if not current_user.is_superuser and (item.owner_id != current_user.id):
-        raise HTTPException(status_code=403, detail="Not enough permissions")
-    return item
+    return _get_item_or_404(session, id)
 
 
 @router.post("/", response_model=ItemPublic)
